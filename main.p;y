# কালার ও বিগ/স্মল ম্যাপিং রুল
def get_number_attributes(num):
    num = int(num)
    # Big / Small
    size = "BIG" if num >= 5 else "SMALL"
    # Color
    if num in [1, 3, 7, 9]:
        color = "GREEN"
    elif num in [2, 4, 6, 8]:
        color = "RED"
    elif num == 0:
        color = "RED+VIOLET"
    else:  # 5
        color = "GREEN+VIOLET"
    return size, color

# প্রগ্রেস বার জেনারেটর
def generate_progress_bar(remaining_sec, total_sec=TOTAL_TIME_SECONDS, length=12):
    progress = max(0, min(1, (total_sec - remaining_sec) / total_sec))
    filled = int(progress * length)
    bar = "█" * filled + "▒" * (length - filled)
    return f"⏳ {remaining_sec}S [{bar}]"

# ==================== প্রেডিকশন লজিক ====================
def analyze_and_predict(all_history):
    """
    ভিডিওর লজিক:
    ১. পেজ ১ ও ২ বাদ দিয়ে (সর্বশেষ ২০টি রেকর্ড স্কিপ করে) পেজ ৩ থেকে ৫০ পর্যন্ত হিস্ট্রি সার্চ করা হয়।
    ২. বর্তমান শেষের ২-৩টি ডিজিট প্যাটার্ন ম্যাচ করানো হয়।
    ৩. অতীতে এই ডিজিটগুলোর পর কোন ২ ডিজিট সবচেয়ে বেশি এসেছে তা বের করে জ্যাকপট প্রেডিকশন দেওয়া হয়।
    ৪. বিগ/স্মল এবং কালার কনফার্মেশন ও একিউরেসি পারসেন্টেজ ক্যালকুলেট করা হয়।
    """
    if len(all_history) < 30:
        # পর্যাপ্ত হিস্ট্রি না থাকলে ডিফল্ট
        return {
            "size": "BIG", "size_pct": 75,
            "num1": 3, "num2": 8,
            "color": "GREEN", "color_pct": 80
        }

    # পেজ ১ ও ২ বাদ (প্রথম ২০টি রেকর্ড স্কিপ)
    current_recent = [x["number"] for x in all_history[:2]]  # শেষের ২ ডিজিট
    search_space = all_history[20:]  # পেজ ৩ থেকে পেজ ৫০ পর্যন্ত

    matched_next_numbers = []
    
    # হিস্ট্রিতে ২ ডিজিট প্যাটার্ন মেলানো
    for i in range(len(search_space) - 2):
        if search_space[i+1]["number"] == current_recent[0] and search_space[i+2]["number"] == current_recent[1]:
            matched_next_numbers.append(search_space[i]["number"])

    # প্যাটার্ন ম্যাচ না পেলে সিঙ্গেল ডিজিট ও হট নাম্বার ট্রেন্ড লজিক
    if len(matched_next_numbers) < 2:
        for i in range(len(search_space) - 1):
            if search_space[i+1]["number"] == current_recent[0]:
                matched_next_numbers.append(search_space[i]["number"])

    if not matched_next_numbers:
        matched_next_numbers = [x["number"] for x in search_space[:20]]

    # সর্বাধিক আসা সেরা ২টি নাম্বার (2-Digit Jackpot Prediction)
    counts = Counter(matched_next_numbers)
    top_two = [num for num, _ in counts.most_common(2)]
    if len(top_two) == 1:
        top_two.append((top_two[0] + 5) % 10)

    num1, num2 = top_two[0], top_two[1]

    # বিগ/স্মল বিশ্লেষণ
    big_votes = sum(1 for n in matched_next_numbers if n >= 5)
    small_votes = len(matched_next_numbers) - big_votes
    total_votes = len(matched_next_numbers)

    if big_votes > small_votes:
        pred_size = "BIG"
        size_pct = int((big_votes / total_votes) * 100)
    elif small_votes > big_votes:
        pred_size = "SMALL"
        size_pct = int((small_votes / total_votes) * 100)
    else:
        pred_size = "❌"  # কনফ্লিক্ট হলে ক্যানসেল
        size_pct = 50

    # কালার বিশ্লেষণ
    green_votes = sum(1 for n in matched_next_numbers if n in [1, 3, 5, 7, 9])
    red_votes = sum(1 for n in matched_next_numbers if n in [0, 2, 4, 6, 8])

    if green_votes > red_votes:
        pred_color = "GREEN"
        color_pct = int((green_votes / total_votes) * 100)
    elif red_votes > green_votes:
        pred_color = "RED"
        color_pct = int((red_votes / total_votes) * 100)
    else:
        pred_color = "❌"
        color_pct = 50

    return {
        "size": pred_size, "size_pct": size_pct,
        "num1": num1, "num2": num2,
        "color": pred_color, "color_pct": color_pct
    }

# ==================== টেলিগ্রাম কীবোর্ড তৈরি ====================
def build_telegram_keyboard(period, remaining_sec, prediction):
    markup = InlineKeyboardMarkup()

    short_period = str(period)[-4:]  # ৪/৩ ডিজিট শর্ট ফরম্যাট
    
    # রো ১: পিরিয়ড এবং সর্বোচ্চ লস রেকর্ড (Max Loss)
    markup.row(
        InlineKeyboardButton(f"PERIOD: {short_period}", callback_data="none"),
        InlineKeyboardButton(f"MAX LOSS: {stats['max_loss_streak']}", callback_data="none")
    )

    # রো ২: প্রগ্রেস বার
    progress_text = generate_progress_bar(remaining_sec, TOTAL_TIME_SECONDS)
    markup.row(InlineKeyboardButton(progress_text, callback_data="none"))

    # রো ৩: বিগ/স্মল | ২-ডিজিট প্রেডিকশন | কালার প্রেডিকশন
    size_btn = f"{prediction['size']} ({prediction['size_pct']}%)" if prediction['size'] != "❌" else "❌ SKIP"
    num_btn = f"NUM: {prediction['num1']}, {prediction['num2']}"
    color_emoji = "🟢 " if prediction['color'] == "GREEN" else "🔴 " if prediction['color'] == "RED" else "⚠️ "
    color_btn = f"{color_emoji}{prediction['color']}" if prediction['color'] != "❌" else "❌"

    markup.row(
        InlineKeyboardButton(size_btn, callback_data="none"),
        InlineKeyboardButton(num_btn, callback_data="none"),
        InlineKeyboardButton(color_btn, callback_data="none")
    )

    # রো ৪+: হিস্ট্রি টেবিল (সর্বশেষ ৮-১০টি ফলাফল)
    for row in history_table[:10]:
        status_text = "WIN" if row["win"] else "LOSS"
        markup.row(
            InlineKeyboardButton(str(row["period"])[-4:], callback_data="none"),
            InlineKeyboardButton(str(row["number"]), callback_data="none"),
            InlineKeyboardButton(row["size"], callback_data="none"),
            InlineKeyboardButton(status_text, callback_data="none")
        )

    return markup

# ==================== API থেকে ডাটা ফেচ ====================
def fetch_live_data():
    try:
        response = requests.get(API_URL, timeout=8)
        if response.status_code == 200:
            return response.json()
    except Exception as e:
        logging.error(f"API Fetch Error: {e}")
    return None

# ==================== মেইন লাইভ লুপ ====================
def run_live_bot():
    global telegram_message_id, current_prediction, last_processed_period
    print("Bot is running 24/7 on terminal...")

    while True:
        try:
            data = fetch_live_data()
            if not data:
                time.sleep(3)
                continue

            current_period = data.get("current_period")
            remaining_seconds = data.get("remaining_seconds", 30)
            history = data.get("history", [])  # পূর্ববর্তী রাউন্ডগুলোর ৫০ পেজের লিস্ট

            # নতুন পিরিয়ড শুরু হলে
            if current_period != last_processed_period:
                # আগের রাউন্ডের ফলাফল চেক করে WIN / LOSS নির্ধারণ
                if current_prediction and history:
                    last_result = history[0]
                    actual_num = int(last_result["number"])
                    actual_size, actual_color = get_number_attributes(actual_num)

                    # উইন লস নির্ণয় (কালার, বিগ/স্মল অথবা জ্যাকপট নাম্বার মিললে WIN)
                    is_jackpot = actual_num in [current_prediction["num1"], current_prediction["num2"]]
                    is_size_win = (current_prediction["size"] == actual_size)
                    is_color_win = (current_prediction["color"] in actual_color)

                    round_won = is_jackpot or is_size_win or is_color_win

                    # স্ট্যাটাস আপডেট (০ থেকে শুরু হওয়া কাউন্টার)
                    stats["total_played"] += 1
                    if round_won:
                        stats["total_wins"] += 1
                        stats["current_loss_streak"] = 0
                    else:
                        stats["total_losses"] += 1
                        stats["current_loss_streak"] += 1
                        if stats["current_loss_streak"] > stats["max_loss_streak"]:
                            stats["max_loss_streak"] = stats["current_loss_streak"]

                    # হিস্ট্রি টেবিলে যোগ
                    history_table.insert(0, {
                        "period": last_result.get("period", last_processed_period),
                        "number": actual_num,
                        "size": actual_size,
                        "win": round_won
                    })

                # নতুন রাউন্ডের জন্য প্রেডিকশন
                current_prediction = analyze_and_predict(history)
                last_processed_period = current_period

            # টেলিগ্রাম মেসেজ এবং কীবোর্ড আপডেট
            markup = build_telegram_keyboard(current_period, remaining_seconds, current_prediction)
            message_text = f"<b>{GAME_NAME}</b>\n<code>{SUB_TITLE}</code>"

            if telegram_message_id is None:
                sent_msg = bot.send_message(
                    CHANNEL_OR_CHAT_ID,
                    message_text,
                    reply_markup=markup,
                    parse_mode="HTML"
                )
                telegram_message_id = sent_msg.message_id
            else:
                try:
                    bot.edit_message_text(
                        message_text,
                        chat_id=CHANNEL_OR_CHAT_ID,
                        message_id=telegram_message_id,
                        reply_markup=markup,
                        parse_mode="HTML"
                    )
                except telebot.apihelper.ApiTelegramException:
                    pass  # মেসেজ অপরিবর্তিত থাকলে টেলিগ্রাম এরর হ্যান্ডলিং

            time.sleep(3)  # প্রতি ৩ সেকেন্ড পর পর প্রগ্রেস বার ও টাইম কাউন্ট আপডেট

        except Exception as err:
            logging.error(f"Runtime Exception: {err}")
            time.sleep(5)

if __name__ == "__main__":
    run_live_bot()
